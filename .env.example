# ---------------------------------------------------------------------------
# Synapr environment configuration
#
# Copy to `.env` (git-ignored) and uncomment what you need, or configure
# everything visually with `synapr ui` -> Configuration tab.
# Precedence: defaults < synapr.config.json < .env < real environment.
# ---------------------------------------------------------------------------

# --- general -----------------------------------------------------
# Human readable project label shown in the dashboard.
# SYNAPR_PROJECT_NAME=Synapr Swarm

# --- gateway -----------------------------------------------------
# Active LLM provider. One of: mock, ollama, openai, openrouter, groq, lmstudio, vllm.
# Also accepts: SYNAPR_GATEWAY_PROVIDER
# SYNAPR_PROVIDER=ollama

# Base URL of the local Ollama daemon.
# Also accepts: OLLAMA_BASE_URL
# SYNAPR_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible endpoint used for the 'openai' provider.
# Also accepts: OPENAI_BASE_URL
# SYNAPR_OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter API base URL.
# SYNAPR_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq API base URL.
# SYNAPR_GROQ_BASE_URL=https://api.groq.com/openai/v1

# LM Studio local server base URL.
# SYNAPR_LMSTUDIO_BASE_URL=http://localhost:1234/v1

# vLLM OpenAI-compatible server base URL.
# SYNAPR_VLLM_BASE_URL=http://localhost:8000/v1

# API key for OpenAI (never written to the config file).
# Also accepts: OPENAI_API_KEY
# SYNAPR_OPENAI_API_KEY=sk-...

# API key for OpenRouter.
# Also accepts: OPENROUTER_API_KEY
# SYNAPR_OPENROUTER_API_KEY=sk-or-...

# API key for Groq.
# Also accepts: GROQ_API_KEY
# SYNAPR_GROQ_API_KEY=gsk_...

# Model used to decompose goals into subtasks.
# SYNAPR_PLANNER_MODEL=qwen2.5-coder:7b

# Comma separated adversarial reviewer models.
# SYNAPR_CRITIC_MODELS=llama3.2:latest,mistral:latest

# Model that synthesises the consensus verdict.
# SYNAPR_ARBITER_MODEL=qwen2.5-coder:7b

# Model used for self-healing merge conflict resolution.
# SYNAPR_RESOLVER_MODEL=qwen2.5-coder:7b

# Multi-modal model used by the optical perception engine.
# SYNAPR_VISION_MODEL=llava:latest

# Per-request LLM timeout in seconds.
# SYNAPR_TIMEOUT_SECONDS=60

# Sampling temperature for all roles (0.0 - 2.0).
# SYNAPR_TEMPERATURE=0.2

# Maximum tokens generated per completion.
# SYNAPR_MAX_TOKENS=4096

# --- worktree ----------------------------------------------------
# Directory (relative to the repo) holding isolated worktrees.
# SYNAPR_WORKTREE_ROOT=.worktrees

# Fallback base branch when detection fails.
# SYNAPR_BASE_BRANCH=main

# Prefix applied to every generated feature branch.
# SYNAPR_BRANCH_PREFIX=synapr/

# Remove a worktree automatically once its merge succeeds.
# SYNAPR_AUTO_CLEANUP=false

# --- editor ------------------------------------------------------
# Force a single editor id (e.g. vscode, cursor, android_studio).
# SYNAPR_PREFERRED_EDITOR=vscode

# JSON map of task keyword -> editor id.
# SYNAPR_EDITOR_OVERRIDES={"backend":"vscode","mobile":"android_studio"}

# JSON map of editor id -> absolute executable path.
# SYNAPR_CUSTOM_EDITOR_PATHS={"myeditor":"/usr/local/bin/myeditor"}

# Spawn editors detached from the Synapr process.
# SYNAPR_LAUNCH_DETACHED=true

# --- perception --------------------------------------------------
# Enable optical window perception and terminal telemetry.
# SYNAPR_PERCEPTION_ENABLED=true

# Seconds between perception polls.
# SYNAPR_PERCEPTION_INTERVAL=2.5

# OCR backend: auto, tesseract, windows_media or regex_terminal.
# SYNAPR_OCR_ENGINE=auto

# Persist window screenshots for later inspection.
# SYNAPR_CAPTURE_SCREENSHOTS=true

# Directory where screenshots are written.
# SYNAPR_SCREENSHOT_DIR=.synapr/screenshots

# --- pipeline ----------------------------------------------------
# Run the detected test suite in every worktree.
# SYNAPR_AUTO_TEST=true

# Merge passing branches back into the base branch.
# SYNAPR_AUTO_MERGE=true

# How many times the resolver may retry a conflicted merge.
# SYNAPR_MAX_HEALING_ATTEMPTS=3

# Fallback test command when auto-detection finds nothing.
# SYNAPR_TEST_COMMAND=pytest -q

# Permit merging even when the test suite fails.
# SYNAPR_ALLOW_FORCE_MERGE=false

# --- ui ----------------------------------------------------------
# Bind address of the local dashboard.
# SYNAPR_UI_HOST=127.0.0.1

# TCP port of the local dashboard.
# SYNAPR_UI_PORT=8765

# Open the default browser when the dashboard starts.
# SYNAPR_UI_OPEN_BROWSER=true

# Allow the dashboard to edit and persist the configuration.
# SYNAPR_UI_ALLOW_CONFIG_WRITES=true

# Relax CORS so non-localhost origins may call the API.
# SYNAPR_UI_ALLOW_REMOTE_ORIGINS=false

# Dashboard polling interval for status widgets.
# SYNAPR_UI_REFRESH_SECONDS=5

